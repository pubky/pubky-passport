{
  "name": "pubky-passport",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:staging:pubky": "vitest run --config vitest.staging.config.ts",
    "test:e2e": "pnpm build && pnpm test:e2e:run",
    "test:e2e:run": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
    "check:critical": "pnpm audit --prod && pnpm check && pnpm test:e2e:run"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3>brace-expansion": "^5.0.8",
      "next>postcss": "^8.5.18",
      "next>sharp": "^0.35.0",
      "postcss>nanoid": "^3.3.18",
      "vite>esbuild": "^0.28.1"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@radix-ui/react-slot": "1.2.4",
    "@synonymdev/pubky": "0.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-result": "2.10.0",
    "class-variance-authority": "0.7.1",
    "client-only": "0.0.1",
    "clsx": "2.1.1",
    "google-auth-library": "^10.9.1",
    "next": "^16.2.12",
    "qr-scanner": "1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^30.0.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
