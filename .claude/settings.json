{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm exec:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git worktree:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(scripts/agent/handoff.sh:*)",
      "Bash(scripts/agent/inbox.sh:*)",
      "Bash(scripts/agent/review.sh:*)",
      "Bash(scripts/agent/review-kimi.sh:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./certificates/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)",
      "Edit(./.env.local)",
      "Edit(./certificates/**)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)",
      "Edit(./scripts/agent/guard-bash.sh)",
      "Write(./scripts/agent/guard-bash.sh)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Read(/srv/coder-secrets/**)",
      "Read(/run/secrets/**)",
      "Edit(./scripts/agent/steward.sh)",
      "Write(./scripts/agent/steward.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent/guard-bash.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "pubky-agent-skills": {
      "source": {
        "source": "github",
        "repo": "pubky/agent-skills"
      }
    }
  },
  "enabledPlugins": {
    "pubky@pubky-agent-skills": true
  }
}
