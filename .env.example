# Browser bootstrap config, read server-side and passed as public values
GOOGLE_CLIENT_ID=
HOMEGATE_URL=

# Server-only config and CSP policy
PUBKY_HOMESERVER_CONNECT_ORIGINS=
PASSPORT_SERVER_SECRET_CURRENT_KEY_ID=
# JSON object mapping public key IDs to base64-encoded server secrets.
PASSPORT_SERVER_SECRET_KEYRING_JSON=

# Optional: Sign in with Apple + iCloud (CloudKit). Off unless APPLE_LOGIN_ENABLED=true; when
# on, every setting below is required. None of these values is secret. Give every environment
# (production, staging, previews) its own Services ID and its own iCloud container: an origin that
# shares them can read, replace or delete another origin's iCloud record and accept its tokens.
APPLE_LOGIN_ENABLED=
# Services ID used as the Sign in with Apple client ID and ID-token audience.
APPLE_SERVICES_ID=
# iCloud container, for example iCloud.app.pubky.passport.
APPLE_CLOUDKIT_CONTAINER_ID=
# CloudKit JS API token for that container (allowed origins set in CloudKit Console).
APPLE_CLOUDKIT_API_TOKEN=
# production (default) or development.
APPLE_CLOUDKIT_ENVIRONMENT=
