# Browser bootstrap config, read server-side and passed as public values
# Optional: Google is offered only with a client ID, provider support, and Homegate availability.
GOOGLE_CLIENT_ID=
HOMEGATE_URL=
# Optional z-base-32 key of the provider's homeserver. It prefills manual invites (people can
# still enter any other homeserver), limits the provider's storage and upgrade copy to identities
# on it, and is where "Republish homeserver" points a missing record of an identity that does not
# remember its own homeserver. There is no default: unset means no provider homeserver, so manual
# invites ask for one and storage copy and republishing stay hidden.
PUBKY_SIGNUP_HOMESERVER=
# Optional HTTPS URL of the HTTP relay Passport's own Ring profile grants use. Defaults to
# https://httprelay.pubky.app/inbox. Run your own relay for production.
PUBKY_HTTP_RELAY_URL=

# Server-only config
PASSPORT_SERVER_SECRET_CURRENT_KEY_ID=
# JSON object mapping public key IDs to base64-encoded server secrets.
PASSPORT_SERVER_SECRET_KEYRING_JSON=

# Optional public instance metadata and signup availability (strict JSON).
# HTTPS URLs only. Omit provider claims/links that do not apply to your homeserver.
# PASSPORT_PROVIDER_CONFIG_JSON={"googleEnabled":false,"verificationMethods":["invite"],"storageDescription":"Your provider’s storage offer","termsUrl":"https://example.com/terms","privacyUrl":"https://example.com/privacy","upgradeUrl":"https://example.com/storage"}
# Optional paymentDescription is shown on the Lightning choice, e.g. "One-time payment".
# Without googleEnabled, Google is on exactly when GOOGLE_CLIENT_ID is set; googleEnabled:false
# turns it off regardless, and googleEnabled:true without a client ID fails startup. The server
# secret keyring is required only while Google is on. HOMEGATE_URL is required with Google, SMS,
# or Lightning enabled. Remote methods also require a successful availability probe. Manual
# invites stay available.

# Optional: comma-separated hosts allowed to use dev-only resources (HMR) through a remote proxy.
# NEXT_ALLOWED_DEV_ORIGINS=
