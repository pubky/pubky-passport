# Public browser config
NEXT_PUBLIC_PASSPORT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_HTTP_RELAY_URL=https://httprelay.pubky.app/inbox
# Optional hostname passed to Pubky.testnet(). Omit for mainnet; local Docker uses localhost.
NEXT_PUBLIC_PUBKY_TESTNET_HOST=
# Exact comma-separated HTTPS homeserver origins allowed by browser CSP.
# Development also permits HTTP localhost origins. Local Docker uses
# http://localhost:15411,http://localhost:6286.
PUBKY_BROWSER_CONNECT_ORIGINS=

# Server-only config
GOOGLE_CLIENT_ID=
PASSPORT_SERVER_SECRET_BASE64=
HOMEGATE_URL=
